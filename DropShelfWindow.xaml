<Window x:Class="WindowsNotch.DropShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FileTitle}" Width="320" Height="300"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="ShelfCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardBorder" Background="#1C1C1E" BorderBrush="#2E2E30" BorderThickness="1"
            CornerRadius="12" Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderRow" Background="Transparent" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                        <Path Data="M1.5,3 H6 L7.5,4.5 H12.5 V11.5 H1.5 Z"
                              Stroke="#F5F5F7" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Files}" Foreground="#F5F5F7"
                               FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FileCountText" Text="{DynamicResource FileCountOne}"
                               Foreground="#6E6E73" FontSize="9"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseButton" Width="18" Height="18"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ShelfCloseButton}"
                        Content="&#x2715;" FontSize="9"
                        Foreground="#9A9A9E"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,9,0,0">
                <ScrollViewer x:Name="ItemsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141416" BorderBrush="#2E2E30"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="7,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Viewbox Width="13" Height="13"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center">
                                            <Path Data="M2,1.5 H8.5 L11,4 V12.5 H2 Z M8.5,1.5 V4 H11"
                                                  Stroke="#9A9A9E" StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Viewbox>

                                        <StackPanel Grid.Column="1" Margin="7,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F5F5F7"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Location}"
                                                       Foreground="#6E6E73"
                                                       FontSize="8.5"
                                                       Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Click="OnOpenItemClick"
                                                    ToolTip="{DynamicResource Open}"
                                                    Style="{StaticResource ShelfIconButton}">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="M3,10 L10,3 M5,3 H10 V8"
                                                          Stroke="#F5F5F7"
                                                          StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnRevealItemClick"
                                                    ToolTip="{DynamicResource RevealInExplorer}"
                                                    Style="{StaticResource ShelfIconButton}">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="M1.5,4 H6 L7.2,5.2 H11.5 V10.5 H1.5 Z"
                                                          Stroke="#F5F5F7"
                                                          StrokeThickness="1.3"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnCopyItemClick"
                                                    ToolTip="{DynamicResource CopyPath}"
                                                    Style="{StaticResource ShelfIconButton}">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="M4,4 H10.5 V11.5 H4 Z M2,2 H8.5 V4 M2,2 V9.5 H4"
                                                          Stroke="#F5F5F7"
                                                          StrokeThickness="1.2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnSendToMobileClick"
                                                    ToolTip="{DynamicResource SendToMobile}"
                                                    Style="{StaticResource ShelfIconButton}"
                                                    Margin="2,0,0,0">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="M6,1.5 L6,8.5 M3,5.5 L6,8.5 L9,5.5 M2,10.5 H10"
                                                          Stroke="#F5F5F7" StrokeThickness="1.3"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnRemoveItemClick"
                                                    ToolTip="{DynamicResource RemoveItem}"
                                                    Style="{StaticResource ShelfIconButton}"
                                                    Margin="2,0,0,0">
                                                <Viewbox Width="10" Height="10">
                                                    <Path Data="M1,1 L9,9 M9,1 L1,9"
                                                          Stroke="#9A9A9E"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyState" Text="{DynamicResource NoFiles}"
                           Foreground="#6E6E73" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text=""
                           Foreground="#6E6E73" FontSize="8.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SendAllButton" Content="{DynamicResource SendAllToMobile}"
                            Style="{StaticResource ShelfTextButton}"
                            Margin="0,0,4,0"/>
                    <Button x:Name="OpenAllButton" Content="{DynamicResource OpenAll}"
                            Style="{StaticResource ShelfTextButton}"/>
                    <Button x:Name="ClearButton" Content="{DynamicResource Clear}"
                            Style="{StaticResource ShelfTextButton}"
                            Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
