<Window x:Class="WindowsNotch.MediaFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FocusMode}"
        Width="760" Height="380"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="FocusTextBrush" Color="#F7F7FA"/>
        <SolidColorBrush x:Key="FocusSoftBrush" Color="#C6C6CE"/>
        <SolidColorBrush x:Key="FocusMutedBrush" Color="#85858D"/>
        <SolidColorBrush x:Key="FocusFaintBrush" Color="#5D5D66"/>
        <SolidColorBrush x:Key="FocusCardBrush" Color="#FF0A0A0D"/>
        <SolidColorBrush x:Key="FocusPanelBrush" Color="#8C121218"/>
        <SolidColorBrush x:Key="FocusBorderBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="FocusAccentBrush" Color="#9CC4FF"/>

        <LinearGradientBrush x:Key="FocusCoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B3B6E" Offset="0"/>
            <GradientStop Color="#151826" Offset="0.55"/>
            <GradientStop Color="#0B0B0F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FocusProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF7FF" Offset="0"/>
            <GradientStop Color="#8FD3FF" Offset="0.4"/>
            <GradientStop Color="#4A90FF" Offset="0.75"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FocusIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusTransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusPlayButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8D8DE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusSlimSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource FocusProgressBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="14">
                            <Border Height="4" CornerRadius="2" Background="#34343A"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusLyricButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Border x:Name="CardBorder"
                Background="{StaticResource FocusCardBrush}"
                BorderBrush="{StaticResource FocusBorderBrush}"
                BorderThickness="1"
                CornerRadius="22"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="DragHeader" Grid.Row="0"
                      Margin="24,14,18,0" Background="Transparent"
                      Cursor="SizeAll">
                    <TextBlock x:Name="HeaderText"
                               Text="{DynamicResource FocusNowPlaying}"
                               Foreground="{StaticResource FocusMutedBrush}"
                               FontSize="9" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="HeaderActions"
                            Grid.Row="0"
                            Panel.ZIndex="10"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,14,18,0"
                            Opacity="1"
                            IsHitTestVisible="True">
                    <Button x:Name="CompactButton"
                            Style="{StaticResource FocusIconButton}"
                            Width="24" Height="24"
                            Margin="0,0,4,0"
                            ToolTip="{DynamicResource FocusCompact}">
                        <Viewbox Width="12" Height="12">
                            <Path Data="M2,1 H12 A1.5,1.5 0 0 1 13.5,2.5 V12.5 A1.5,1.5 0 0 1 12,14 H2 A1.5,1.5 0 0 1 0.5,12.5 V2.5 A1.5,1.5 0 0 1 2,1 Z M7,1 V14"
                                  Stroke="{StaticResource FocusSoftBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Button>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource FocusIconButton}"
                            Width="24" Height="24"
                            ToolTip="{DynamicResource FocusClose}">
                        <Viewbox Width="12" Height="12">
                            <Path Data="M1,1 L13,13 M13,1 L1,13"
                                  Stroke="{StaticResource FocusSoftBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Grid x:Name="Viewport" Grid.Row="1" Margin="24,10,24,20"
                      ClipToBounds="True">
                    <Grid x:Name="SlideHost" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NowPlayingColumn" Width="208"/>
                            <ColumnDefinition x:Name="LyricsColumn" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="NowPlayingRow" Height="*"/>
                            <RowDefinition x:Name="LyricsRow" Height="0"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="NowPlayingPage" Grid.Row="0" Grid.Column="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="NowPlayingTranslate"/>
                            </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="CoverBorder" Width="150" Height="150"
                                CornerRadius="14" ClipToBounds="True"
                                HorizontalAlignment="Left"
                                Background="{StaticResource FocusCoverBrush}">
                            <Grid>
                                <TextBlock x:Name="CoverPlaceholderGlyph"
                                           Text="&#x266B;"
                                           FontSize="46"
                                           Foreground="#4DFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image x:Name="CoverImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border x:Name="SourceBadge"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="10"
                                        CornerRadius="11"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Grid Width="16" Height="16">
                                        <Viewbox x:Name="SpotifyLogo" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Width="24" Height="24" Fill="#1ED760"/>
                                                <Path Data="M6.2,8.3 C9.4,7.2 13.7,7.4 17.4,9.1"
                                                      Stroke="#FFFFFF" StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                                <Path Data="M6.7,12.1 C9.6,11.2 13.3,11.4 16.7,12.9"
                                                      Stroke="#FFFFFF" StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                                <Path Data="M7.2,15.9 C9.5,15.3 12.1,15.4 15,16.7"
                                                      Stroke="#FFFFFF" StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>

                                        <Viewbox x:Name="ChromeLogo" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0z"
                                                      Fill="#EA4335"/>
                                                <Path Data="M1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29z"
                                                      Fill="#34A853"/>
                                                <Path Data="M15.273 7.636a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-5.344 9.257c.206.01.413.016.621.016 6.627 0 12-5.373 12-12 0-1.54-.29-3.011-.818-4.364z"
                                                      Fill="#FBBC05"/>
                                                <Path Data="M12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728Z"
                                                      Fill="#4285F4"/>
                                            </Canvas>
                                        </Viewbox>

                                        <Viewbox x:Name="GenericSourceLogo" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12,3V13.55A3.45,3.45 0 0,0 10.5,13A3.5,3.5 0 1,0 12,16.5V7H17V3H12Z"
                                                      Fill="#FFFFFF"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TitleText"
                                   Grid.Row="1"
                                   Text="{DynamicResource NoMediaPlaying}"
                                   Foreground="{StaticResource FocusTextBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="44"
                                   Margin="0,10,0,0"/>

                        <TextBlock x:Name="ArtistText"
                                   Grid.Row="2"
                                   Foreground="{StaticResource FocusMutedBrush}"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"
                                   Text="{DynamicResource NoMediaHint}"/>

                        <Grid x:Name="ProgressPanel" Grid.Row="5" Margin="0,8,0,0">
                            <Slider x:Name="ProgressSlider"
                                    Style="{StaticResource FocusSlimSlider}"
                                    Maximum="1"
                                    Value="0"/>
                        </Grid>

                        <Grid Grid.Row="6" Margin="0,2,0,0">
                            <TextBlock x:Name="PositionText"
                                       Text="0:00"
                                       Foreground="{StaticResource FocusMutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="DurationText"
                                       Text="--:--"
                                       Foreground="{StaticResource FocusMutedBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel x:Name="ControlsPanel"
                                    Grid.Row="7"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                            <Button x:Name="PrevButton"
                                    Style="{StaticResource FocusTransportButton}"
                                    ToolTip="Previous">
                                <Path Data="M0,1 V13 M12,1 L3,7 L12,13 Z"
                                      Fill="{StaticResource FocusSoftBrush}"
                                      Stroke="{StaticResource FocusSoftBrush}"
                                      StrokeThickness="1"
                                      StrokeLineJoin="Round"/>
                            </Button>

                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource FocusPlayButton}"
                                    Margin="12,0">
                                <Path x:Name="PlayPausePath"
                                      Data="M0,0 L12,7 L0,14 Z"
                                      Margin="1.5,0,0,0"
                                      Fill="#101014"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="NextButton"
                                    Style="{StaticResource FocusTransportButton}"
                                    ToolTip="Next">
                                <Path Data="M0,1 L9,7 L0,13 M12,1 V13"
                                      Fill="{StaticResource FocusSoftBrush}"
                                      Stroke="{StaticResource FocusSoftBrush}"
                                      StrokeThickness="1"
                                      StrokeLineJoin="Round"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                        <Grid x:Name="LyricsPage" Grid.Row="0" Grid.Column="1" Margin="26,0,0,0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="LyricsTranslate"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="LyricsTitleText"
                                       Text="{DynamicResource LyricsTitle}"
                                       Foreground="{StaticResource FocusMutedBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,8">
                                <Border x:Name="LyricsGlow"
                                        IsHitTestVisible="False"
                                        Opacity="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="460"
                                        Height="280"
                                        Background="Transparent">
                                    <Image x:Name="LyricsGlowImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <Grid x:Name="LyricsSyncedPanel">
                                <ScrollViewer x:Name="LyricsScroll"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False"
                                              PanningMode="None">
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#FF000000" Offset="0.16"/>
                                            <GradientStop Color="#FF000000" Offset="0.84"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <StackPanel x:Name="LyricsStack" Margin="0,0,10,0"/>
                                </ScrollViewer>
                            </Grid>

                            <ScrollViewer x:Name="PlainLyricsScroll"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          PanningMode="None">
                                <TextBlock x:Name="PlainLyricsText"
                                           Foreground="{StaticResource FocusSoftBrush}"
                                           FontSize="12.5"
                                           LineHeight="21"
                                           TextWrapping="Wrap"
                                           Margin="0,0,10,0"/>
                            </ScrollViewer>

                            <StackPanel x:Name="LyricsLoadingPanel"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#x266B;"
                                           FontSize="26"
                                           Foreground="{StaticResource FocusFaintBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LyricsLoadingText"
                                           Text="{DynamicResource LyricsLoading}"
                                           Foreground="{StaticResource FocusMutedBrush}"
                                           FontSize="10.5"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="LyricsEmptyPanel"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#x266B;"
                                           FontSize="34"
                                           Foreground="{StaticResource FocusFaintBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LyricsEmptyText"
                                           Text="{DynamicResource NoLyrics}"
                                           Foreground="{StaticResource FocusSoftBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LyricsEmptyHint"
                                           Text="{DynamicResource NoMediaHint}"
                                           Foreground="{StaticResource FocusFaintBrush}"
                                           FontSize="9.5"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Grid x:Name="VisualizerPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="VisualizerMessageText"
                                           Grid.Row="0"
                                           Text="{DynamicResource NoLyrics}"
                                           Foreground="{StaticResource FocusSoftBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <StackPanel x:Name="VisualizerBars"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Height="96"/>

                                <TextBlock x:Name="VisualizerDetailText"
                                           Grid.Row="2"
                                           Text="{DynamicResource NoLyricsHint}"
                                           Foreground="{StaticResource FocusFaintBrush}"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="AttributionText"
                                   Grid.Row="2"
                                   Text="{DynamicResource LyricsAttribution}"
                                   Foreground="{StaticResource FocusFaintBrush}"
                                   FontSize="8"
                                   HorizontalAlignment="Right"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>

                <StackPanel x:Name="PageDots" Grid.Row="1"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Visibility="Collapsed">
                    <Ellipse x:Name="PageDot0" Width="6" Height="6"
                             Fill="#FFFFFFFF" Margin="0,3" Cursor="Hand"/>
                    <Ellipse x:Name="PageDot1" Width="6" Height="6"
                             Fill="#FFFFFFFF" Opacity="0.35"
                             Margin="0,3" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
