<Window x:Class="WindowsNotch.CalendarNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar Note" Width="260" Height="130"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Width="250" Background="#1C1C1E"
            BorderBrush="#2E2E30" BorderThickness="1"
            CornerRadius="12" Padding="12"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="CalendarNotePopupDateText"
                           Text="12 November 2026"
                           Foreground="#F5F5F7" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button x:Name="CalendarNoteCloseButton"
                        Width="20" Height="20"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="&#x2715;" FontSize="10" Foreground="#9A9A9E"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Focusable="False"/>
            </Grid>

            <Border Grid.Row="1" Background="#141416" BorderBrush="#2E2E30"
                    BorderThickness="1" CornerRadius="8" Padding="8,6">
                <TextBox x:Name="CalendarNoteInput"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#F5F5F7" CaretBrush="#F5F5F7"
                         FontSize="11.5" Padding="0"
                         MaxLength="120"
                         TextWrapping="Wrap" AcceptsReturn="False"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="CalendarNoteDeleteButton" Content="{DynamicResource Delete}"
                        HorizontalAlignment="Left" Foreground="#8E8E93"
                        Background="Transparent" BorderThickness="0"
                        FontSize="11" Cursor="Hand" Padding="2,2"/>
                <Button x:Name="CalendarNoteSaveButton" Content="{DynamicResource Save}"
                        HorizontalAlignment="Right" Foreground="#FFFFFF"
                        Background="#2C2C2E" BorderThickness="0"
                        FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Padding="14,4">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
