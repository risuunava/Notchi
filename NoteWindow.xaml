<Window x:Class="WindowsNotch.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NoteTitle}" Width="260" Height="170"
        MinWidth="200" MinHeight="140"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="NoteCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardBorder" Background="#1C1C1E" BorderBrush="#2E2E30" BorderThickness="1"
            CornerRadius="12" Padding="12">

        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderRow" Background="Transparent" Cursor="SizeAll">
                    <StackPanel x:Name="HeaderTitle" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Data="M2,1.5 H8.5 L11,4 V12.5 H2 Z M8.5,1.5 V4 H11 M4,6.5 H9 M4,9 H9"
                                  Stroke="#F5F5F7" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Notes}" Foreground="#F5F5F7"
                                   FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Text="{DynamicResource Saved}"
                               Foreground="#6E6E73" FontSize="9"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,22,0"/>

                    <Button x:Name="CloseButton" Width="18" Height="18"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource NoteCloseButton}"
                            Content="&#x2715;" FontSize="9"
                            Foreground="#9A9A9E"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,9,0,0"
                        Background="#141416" BorderBrush="#2E2E30"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <TextBox x:Name="NoteTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#F5F5F7" CaretBrush="#F5F5F7"
                                 SelectionBrush="#3D7EFF"
                                 FontSize="12" Padding="0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="PlaceholderText" Text="{DynamicResource NotePlaceholder}"
                                   Foreground="#6E6E73" FontSize="12"
                                   IsHitTestVisible="False" Margin="1,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ResizeGrip" Width="18" Height="18"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-9,-9" Background="Transparent"
                    Cursor="SizeNWSE">
                <Path Data="M2,16 L16,2 M8,17 L17,8 M13,18 L18,13"
                      Stroke="#8E8E93" StrokeThickness="1.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Opacity="0.55"/>
            </Border>
        </Grid>
    </Border>
</Window>
