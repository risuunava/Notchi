<Window x:Class="WindowsNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="330" Height="480"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Close Button -->
        <Style x:Key="SettingsCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button -->
        <Style x:Key="SettingsTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D0D0D6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language Pill Radio -->
        <Style x:Key="SettingsLanguageOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#1C1C1E" CornerRadius="5"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D0D0D6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D7EFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="30" Height="17"
                                CornerRadius="8.5" Background="#3A3A3E">
                            <Border x:Name="Thumb" Width="13" Height="13"
                                    CornerRadius="6.5" Background="#FFFFFF"
                                    HorizontalAlignment="Left" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3D7EFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action / Primary Button -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3D7EFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F8CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D6EEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#4A2020"/>
            <Setter Property="Background" Value="#2C1A1A"/>
        </Style>

        <!-- Settings TextBox -->
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333336"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardBorder" Background="#161618" BorderBrush="#26262A" BorderThickness="1"
            CornerRadius="14" Padding="14,12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Tabs -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid x:Name="HeaderRow" Grid.Row="0" Background="Transparent" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                        <Path Data="M1,3 H13 M1,7 H13 M1,11 H13 M4,1.5 V4.5 M9,5.5 V8.5 M5,9.5 V12.5"
                              Stroke="#8E8E93" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource SettingsTitle}" Foreground="#E5E5EA"
                               FontSize="11.5" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Saved}"
                               Foreground="#6E6E73" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton" Width="20" Height="20"
                            Style="{StaticResource SettingsCloseButton}"
                            Content="&#x2715;" FontSize="9.5"
                            Foreground="#8E8E93"/>
                </StackPanel>
            </Grid>

            <!-- 2. Segmented Navigation Tabs -->
            <Border Grid.Row="1" Background="#1E1E22" CornerRadius="8" Padding="2" Margin="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="GeneralTabRadio" Grid.Column="0"
                                 GroupName="SettingsTabs" IsChecked="True"
                                 Content="Umum"
                                 Style="{StaticResource SettingsTabRadio}"/>
                    <RadioButton x:Name="MobileTabRadio" Grid.Column="1"
                                 GroupName="SettingsTabs"
                                 Content="Notchi Mobile"
                                 Style="{StaticResource SettingsTabRadio}"/>
                </Grid>
            </Border>

            <!-- 3. Tab Contents -->
            <Grid Grid.Row="2">
                <!-- TAB 1: UMUM (General) -->
                <ScrollViewer x:Name="GeneralTabContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,2,0">
                        <!-- Group 1: Sistem -->
                        <TextBlock Text="{DynamicResource System}" Foreground="#6E6E73"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#202024" CornerRadius="9" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StartupTitle}"
                                               Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource StartupDescription}"
                                               Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                                          Style="{StaticResource SettingsToggle}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Group: Volume -->
                        <TextBlock Text="{DynamicResource VolumeSection}" Foreground="#6E6E73"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#202024" CornerRadius="9" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource VolumeTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource VolumeDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="MuteToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="50"
                                            VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                                    <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="50%"
                                               Foreground="#8E8E93" FontSize="9"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="30"
                                               TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Bahasa -->
                        <TextBlock Text="{DynamicResource LanguageSection}" Foreground="#6E6E73"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#202024" CornerRadius="9" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bahasa Tampilan" Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="Pilih bahasa antarmuka" Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#161618" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="IndonesianOption"
                                                     GroupName="Language"
                                                     Content="{DynamicResource LanguageIndonesian}"
                                                     Style="{StaticResource SettingsLanguageOption}"/>
                                        <RadioButton x:Name="EnglishOption"
                                                     GroupName="Language"
                                                     Content="{DynamicResource LanguageEnglish}"
                                                     Style="{StaticResource SettingsLanguageOption}"
                                                     Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Group 3: Pintasan -->
                        <TextBlock Text="{DynamicResource HotkeySection}" Foreground="#6E6E73"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#202024" CornerRadius="9" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource HotkeyTitle}"
                                               Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource HotkeyDescription}"
                                               Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="HotkeyRecorder" Grid.Column="1"
                                        Background="#161618" CornerRadius="6"
                                        Padding="10,5" VerticalAlignment="Center" Cursor="Hand"
                                        MinWidth="85" BorderThickness="1"
                                        BorderBrush="#333336">
                                    <TextBlock x:Name="HotkeyLabel"
                                               Foreground="#F5F5F7" FontSize="10"
                                               HorizontalAlignment="Center"
                                               FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Group 4: Fokus Media -->
                        <TextBlock Text="{DynamicResource FocusSection}" Foreground="#6E6E73"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,4,0,4"/>
                        <Border Background="#202024" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FocusHotkeyTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource FocusHotkeyDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="FocusHotkeyRecorder" Grid.Column="1"
                                            Background="#161618" CornerRadius="6"
                                            Padding="10,5" VerticalAlignment="Center" Cursor="Hand"
                                            MinWidth="85" BorderThickness="1"
                                            BorderBrush="#333336">
                                        <TextBlock x:Name="FocusHotkeyLabel"
                                                   Foreground="#F5F5F7" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#2A2A2E" Margin="0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FocusLyricsTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource FocusLyricsDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EnableLyricsToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#2A2A2E" Margin="0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FocusHideNotchTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource FocusHideNotchDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="HideNotchToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: NOTCHI MOBILE -->
                <ScrollViewer x:Name="MobileTabContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,2,0">
                        <!-- Group 1: Server Status & Switch -->
                        <Border Background="#202024" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource MobileServerTitle}"
                                               Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource MobileServerDescription}"
                                               Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="MobileServerToggle" Grid.Column="1"
                                          Style="{StaticResource SettingsToggle}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Group 2: Port & File Limit -->
                        <Border Background="#202024" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource MobilePort}" Foreground="#8E8E93" FontSize="8.5" FontWeight="Medium"/>
                                    <TextBox x:Name="MobilePortBox" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource MobileMaxFileSize}" Foreground="#8E8E93" FontSize="8.5" FontWeight="Medium"/>
                                    <TextBox x:Name="MobileMaxFileSizeBox" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Button: Pasangkan Perangkat -->
                        <Button x:Name="PairDeviceButton"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,0,0,12" Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x25A3;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PairNewDevice}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Group 3: Daftar Perangkat Terhubung -->
                        <TextBlock Text="{DynamicResource PairedDevices}" Foreground="#6E6E73"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>

                        <Border Background="#202024" CornerRadius="9" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="NoDevicesLabel" Text="{DynamicResource NoPairedDevices}"
                                           Foreground="#8E8E93" FontSize="9" FontStyle="Italic"
                                           HorizontalAlignment="Center" Margin="0,8,0,8"/>

                                <ItemsControl x:Name="DevicesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181A" CornerRadius="7" Padding="9,6" Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeviceName}" Foreground="#F5F5F7" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding LastSeen, StringFormat='Terakhir aktif: {0:HH:mm dd/MM}'}"
                                                                   Foreground="#85858D" FontSize="8" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{DynamicResource Revoke}"
                                                            Style="{StaticResource DangerActionButton}"
                                                            Tag="{Binding DeviceId}"
                                                            Click="OnRevokeDeviceClick"
                                                            Padding="7,3" FontSize="8.5"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
